{
  "app": "npx tsx bin/app.ts",
  "context": {
    "environment": "dev",
    "bedrockModelId": "apac.amazon.nova-lite-v1:0",
    "bedrockModelRegions": [
      "ap-south-1",
      "ap-southeast-1",
      "ap-southeast-2",
      "ap-northeast-1",
      "ap-northeast-2",
      "ap-northeast-3"
    ],
    "@aws-cdk/aws-lambda:useCdkManagedLogGroup": false,
    "@aws-cdk/core:defaultCrossStackReferences": "strong"
  }
}
